<Window x:Class="ScreenTranslator.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTranslator"
        Title="{local:Loc history.window}"
        Width="480" Height="560" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{local:Loc history.title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{local:Loc history.subtitle}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource HistoryItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10,10,14" Margin="0,0,10,8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Timestamp, StringFormat='dd MMM, HH:mm'}"
                                               Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    <Button Content="{local:Loc history.copy}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                            Tag="{Binding TranslatedText}" Click="BtnCopy_Click"/>
                                </Grid>
                                <TextBlock Text="{Binding OriginalText}" Foreground="{StaticResource TextSecondary}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                <TextBlock Text="{Binding TranslatedText}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyState" Text="{local:Loc history.empty}"
                       Style="{StaticResource Hint}" TextAlignment="Center" HorizontalAlignment="Center"
                       VerticalAlignment="Center" MaxWidth="280" Visibility="Collapsed"/>
        </Grid>

        <Button x:Name="BtnClear" Grid.Row="2" Content="{local:Loc history.clear}" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" Margin="0,14,0,0" Click="BtnClear_Click"/>
    </Grid>
</Window>