<Window x:Class="ScreenTranslator.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation History" Height="480" Width="420"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🕘 Translation History" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ListBox Grid.Row="1" x:Name="HistoryList" Background="#252525" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2D2D2D" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="#888888" FontSize="10"/>
                            <TextBlock Text="{Binding OriginalText}" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding TranslatedText}" Foreground="White" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Clear History" Background="#3A3A3A" Foreground="White" Padding="8"
                BorderThickness="0" Cursor="Hand" Margin="0,10,0,0" Click="BtnClear_Click"/>
    </Grid>
</Window>
