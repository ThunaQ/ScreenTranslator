<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTranslator" Height="450" Width="800"
        ShowInTaskbar="False" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#80000000" 
        Topmost="True"
        Cursor="Cross"
        Loaded="Window_Loaded">
    <Canvas x:Name="CanvasArea" 
            Background="Transparent"
            MouseLeftButtonDown="CanvasArea_MouseLeftButtonDown"
            MouseMove="CanvasArea_MouseMove"
            MouseLeftButtonUp="CanvasArea_MouseLeftButtonUp">

        <Rectangle x:Name="SelectionBox" 
                   Stroke="Red" 
                   StrokeThickness="2" 
                   Fill="#33FF0000" 
                   Visibility="Collapsed"/>
    </Canvas>
</Window>